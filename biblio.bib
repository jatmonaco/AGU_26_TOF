@article{close_ScatteringCharacteristicsHighresolution_2002,
  title = {Scattering Characteristics of High-Resolution Meteor Head Echoes Detected at Multiple Frequencies},
  author = {Close, S. and Oppenheim, M. and Hunt, S. and Dyrud, L.},
  year = 2002,
  journal = {Journal of Geophysical Research: Space Physics},
  volume = {107},
