  shorttitle = {Atmospheric Tomography Using the {{Nordic Meteor Radar Cluster}} and {{Chilean Observation Network De Meteor Radars}}},
  author = {Stober, Gunter and Kozlovsky, Alexander and Liu, Alan and Qiao, Zishun and Tsutsumi, Masaki and Hall, Chris and Nozawa, Satonori and Lester, Mark and Belova, Evgenia and Kero, Johan and Espy, Patrick J. and Hibbins, Robert E. and Mitchell, Nicholas},
  year = 2021,
