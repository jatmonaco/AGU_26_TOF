@article{conte_ComparisonMLTMomentum_2022,
  title = {Comparison of {{MLT Momentum Fluxes Over}} the {{Andes}} at {{Four Different Latitudinal Sectors Using Multistatic Radar Configurations}}},
  author = {Conte, J. Federico and Chau, Jorge L. and Liu, Alan and Qiao, Zishun and Fritts, David C. and Hormaechea, Jos{\'e} L. and Salvador, Jacobo O. and Milla, Marco A.},
  year = 2022,
  journal = {Journal of Geophysical Research: Atmospheres},
  volume = {127},
