@inproceedings{sciancalepore_ShootingStarsSecure_2018,
  title = {Shooting to the {{Stars}}: {{Secure Location Verification}} via {{Meteor Burst Communications}}},
  shorttitle = {Shooting to the {{Stars}}},
  booktitle = {2018 {{IEEE Conference}} on {{Communications}} and {{Network Security}} ({{CNS}})},
  author = {Sciancalepore, Savio and Oligeri, Gabriele and Pietro, Roberto Di},
