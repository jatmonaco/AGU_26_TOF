  author = {Stober, Gunter and Janches, Diego and Matthias, Vivien and Fritts, Dave and Marino, John and {Moffat-Griffin}, Tracy and Baumgarten, Kathrin and Lee, Wonseok and Murphy, Damian and Kim, Yong Ha and Mitchell, Nicholas and Palo, Scott},
  year = 2021,
