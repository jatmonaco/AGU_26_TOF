@article{jia_MultiyearObservationsGravity_2018,
  title = {Multiyear {{Observations}} of {{Gravity Wave Momentum Fluxes}} in the {{Midlatitude Mesosphere}} and {{Lower Thermosphere Region}} by {{Meteor Radar}}},
  author = {Jia, Mingjiao and Xue, Xianghui and Gu, Shengyang and Chen, Tingdi and Ning, Baiqi and Wu, Jianfei and Zeng, Xuanyun and Dou, Xiankang},
  year = 2018,
  journal = {Journal of Geophysical Research: Space Physics},
  volume = {123},
  number = {7},
  pages = {5684--5703},
  issn = {2169-9402},
  doi = {10.1029/2018JA025285},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1029/2018JA025285},
  urldate = {2023-07-24},
  abstract = {Multiyear high-frequency gravity wave (GW) momentum fluxes and variances in the mesosphere and lower thermosphere region are revealed using four meteor radars along 120{$^\circ$}E longitude at Northern Hemisphere midlatitudes for the first time, which are located at Mohe (53.5{$^\circ$}N, 122.3{$^\circ$}E), Beijing (40.3{$^\circ$}N, 116.2{$^\circ$}E), Mengcheng (33.3{$^\circ$}N, 116.5{$^\circ$}E), and Wuhan (30.5{$^\circ$}N, 114.2{$^\circ$}E), respectively. The seasonal and latitudinal variations of GW momentum fluxes in the midlatitude are discussed. The directions of the monthly mean zonal momentum fluxes are mostly against the background mean zonal winds, which agree well with the selective filtering mechanism. The seasonal variations of meridional momentum fluxes have similar trends over all four stations. The latitudinal variations in the seasonal variation of GW momentum fluxes are mainly due to the latitudinal variations of background winds and GW sources. The unexpected eastward momentum fluxes in winter over Beijing are likely caused by the secondary GWs propagating eastward from the source region over the Tibetan Plateau (25{$^\circ$}--40{$^\circ$}N, 70--100{$^\circ$}E). The GW variances show a V-shaped structure indicating annual and semiannual variations over four stations in zonal component. A quasi-4-month oscillation was observed over Mohe, Mengcheng, and Wuhan in meridional component. The background winds play decisive roles in these GW variance structures.},
  copyright = {\copyright 2018. American Geophysical Union. All Rights Reserved.},
  langid = {english},
  keywords = {gravity wave,meteor radar,MLT,momentum flux},
  file = {C\:\\Users\\janem\\Zotero\\storage\\85H8JNLX\\Jia et al. - 2018 - Multiyear Observations of Gravity Wave Momentum Fluxes in the Midlatitude Mesosphere and Lower Therm.pdf;C\:\\Users\\janem\\Zotero\\storage\\7WMELAXR\\2018JA025285.html}
}

@article{jones_ImprovedInterferometerDesign_1998,
  title = {An Improved Interferometer Design for Use with Meteor Radars},
  author = {Jones, J. and Webster, A. R. and Hocking, W. K.},
  year = 1998,
  month = jan,
  journal = {Radio Science},
  volume = {33},
  number = {1},
  pages = {55--65},
  issn = {1944-799X},
  doi = {10.1029/97RS03050},
  abstract = {The measurement of the directions of radio meteors with an interferometric system is beset by two problems: (1) The ambiguity in the measured directions for antennas spaced by more than {$\lambda$}/2 and (2) the effects of mutual impedance when the antennas are spaced at {$\lambda$}/2 and less to avoid these ambiguities. In this paper we discuss the effects of mutual impedance between spaced antennas and describe an interferometer which both minimizes these effects and avoids the ambiguities associated with spacings larger than {$\lambda$}/2. We have modeled a version of this design numerically and show that under ideal conditions an interferometer of total span 4.5{$\lambda$} can yield directions accurate to about 0.3{$^\circ$} with a signal-to-noise ratio of 20 dB. Finally, we have tested the design with observations from the 1996 Geminid and 1997 Quadrantid meteor showers and find that even without a ground plane, the interferometer provides unambiguous directions to an accuracy of the order of 1.5{$^\circ$}.},
  keywords = {Antenna measurements,Antennas,Atmospheric measurements,Measurement uncertainty,Mutual coupling,Phase measurement,Radar},
  file = {C\:\\Users\\janem\\Zotero\\storage\\3RKKLTSU\\Jones et al_1998_An improved interferometer design for use with meteor radars.pdf;C\:\\Users\\janem\\Zotero\\storage\\DHX5V9L5\\7770878.html}
}

