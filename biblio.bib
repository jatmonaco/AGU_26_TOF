  urldate = {2025-09-19},
  abstract = {We introduce Shooting to the Stars, in short SttS, a secure location verification algorithm leveraging Meteor Burst Communications (MBC)-the ephemeral, ionized stripe generated by meteors. SttS leverages intrinsic peculiarities of MBC, such as robustness to both eavesdropping and jamming, while also enjoying ease of deployment and secure authentication of the transmitting source. SttS enables the verification of the position of a passive receiver by exploiting the radio reflection properties of ephemeral meteor trails, combined with multiple anchors (N) that can be deployed even hundreds of Km from the receiver itself. We developed a complete theoretical model for our solution- rooted on sound literature and past experimental campaigns-, and fully tested it with extensive simulations. Results show that SttS is highly reliable in guaranteeing position verification, and that ({$\lceil$}N/2{$\rceil$}-1) anchors are compromised by an adversary. Finally, it can detect a location spoofing attack even when up to it is completely tunable, trading off accuracy with the number of observed trails-for instance, observing just 200 trails enables to correctly classify the the location as valid or not with a 0.99 probability.},
  keywords = {Communication networks,Conferences,first pass,Global Positioning System,Protocols,Receivers,Security,Terrestrial atmosphere},
  file = {C:\Users\janem\Zotero\storage\2N7M3XIT\Sciancalepore et al. - 2018 - Shooting to the Stars Secure Location Verification via Meteor Burst Communications.pdf}
}

