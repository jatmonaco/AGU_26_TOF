@article{stober_MeteorRadarVertical_2022,
  title = {Meteor Radar Vertical Wind Observation Biases and Mathematical Debiasing Strategies Including the {{3DVAR}}+{{DIV}} Algorithm},
  author = {Stober, Gunter and Liu, Alan and Kozlovsky, Alexander and Qiao, Zishun and Kuchar, Ales and Jacobi, Christoph and Meek, Chris and Janches, Diego and Liu, Guiping and Tsutsumi, Masaki and Gulbrandsen, Nj{\aa}l and Nozawa, Satonori and Lester, Mark and Belova, Evgenia and Kero, Johan and Mitchell, Nicholas},
  year = 2022,
