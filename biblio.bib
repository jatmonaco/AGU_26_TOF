@article{pancheva_ClimatologyNonmigratingTides_2024,
  title = {Climatology of the {{Nonmigrating Tides Based}} on {{Long-Term SABER}}/{{TIMED Measurements}} and {{Their Impact}} on the {{Longitudinal Structures Observed}} in the {{Ionosphere}}},
  author = {Pancheva, Dora and Mukhtarov, Plamen and Bojilova, Rumiana},
  year = 2024,
  month = apr,
  journal = {Atmosphere},
  volume = {15},
  number = {4},
  pages = {478},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2073-4433},
  doi = {10.3390/atmos15040478},
  url = {https://www.mdpi.com/2073-4433/15/4/478},
  urldate = {2025-02-12},
  abstract = {This paper presents climatological features of the longitudinal structures WN4, WN3, and WN2 and their drivers observed in the lower thermospheric temperatures and in the ionospheric TEC. For this purpose, two long-term data sets are utilized: the satellite SABER/TIMED temperature measurements, and the global TEC maps generated with the NASA JPL for the interval of 2002--2022. As the main drivers of the longitudinal structures are mainly nonmigrating tides, this study first investigates the climatology of those nonmigrating tides, which are the main contributors of the considered longitudinal structures; these are nonmigrating diurnal DE3, DE2, and DW2, and semidiurnal SW4 and SE2 tides. The climatology of WN4, WN3, and WN2 structures in the lower thermosphere reveals that WN4 is the strongest one with a magnitude of \textasciitilde 20 K observed at 10{$^\circ$} S in August, followed by WN2 with \textasciitilde 13.9 K at 10{$^\circ$} S in February, and the weakest is WN3 with \textasciitilde 12.4 K observed over the equator in July. In the ionosphere, WN3 is the strongest structure with a magnitude of 5.9 TECU located at -30{$^\circ$} modip latitude in October, followed by WN2 with 5.4 TECU at 30 modip in March, and the last is WN4 with 3.7 TECU at -30 modip in August. Both the climatology of the WSA and the features of its drivers are investigated as well.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {climatology of longitudinal TEC structures and WSA anomaly,climatology of nonmigrating tides,global structure,seasonal and interannual variability},
