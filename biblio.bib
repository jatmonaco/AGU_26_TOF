@article{palmer_PhaseCalibrationVHF_1996,
  title = {Phase Calibration of {{VHF}} Spatial Interferometry Radars Using Stellar Sources},
  author = {Palmer, R. D. and Vangal, S. and Larsen, M. F. and Fukao, S. and Nakamura, T. and Yamamoto, M.},
  year = 1996,
  month = jan,
  journal = {Radio Science},
