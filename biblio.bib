@article{thomas_ResponseHighFrequency_1988,
  title = {Response of High Frequency Radar to Meteor Backscatter},
  author = {Thomas, R. M. and Whitham, P. S. and Elford, W. G.},
  year = 1988,
  month = aug,
  journal = {Journal of Atmospheric and Terrestrial Physics},
  volume = {50},
