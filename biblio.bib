@article{stober_PolarizationDependencyTransverse_2023,
  title = {Polarization Dependency of Transverse Scattering and Collisional Coupling to the Ambient Atmosphere from Meteor Trails --- Theory and Observations},
  author = {Stober, Gunter and Weryk, Robert and Janches, Diego and Dawkins, Erin C. M. and G{\"u}nzkofer, Florian and Hormaechea, Jose Luis and Pokhotelov, Dimitry},
  year = 2023,
  month = nov,
  journal = {Planetary and Space Science},
