  url = {https://angeo.copernicus.org/articles/23/2433/2005/},
  urldate = {2022-08-19},
  abstract = {{$<$}p{$><$}strong class="journal-contentHeaderColor"{$>$}Abstract.{$<$}/strong{$>$} The current primary radar method for determination of atmospheric momentum fluxes relies on multiple beam studies, usually using oppositely directed coplanar beams. Generally VHF and MF radars are used, and meteor radars have never been successfully employed. In this paper we introduce a new procedure that can be used for determination of gravity wave fluxes down to time scales of 2-3h, using the SKiYMET meteor radars. The method avoids the need for beam forming, and allows simultaneous determination of the three components of the wind averaged over the radar volume, as well as the variance and flux components {$<$}img src="ag-23-2433-img1.gif" alt="\$overline \textbraceleft u'\textasciicircum 2\textbraceright,overline \textbraceleft v'\textasciicircum 2\textbraceright,overline \textbraceleft w'\textasciicircum 2\textbraceright, overline \textbraceleft u'v'\textbraceright,overline \textbraceleft u'w'\textbraceright{} \textbraceleft rm and\textbraceright{} : overline \textbraceleft v'w'\textbraceright\$" align="middle" border="0" height="38" width="207"{$>$}, where {$<$}img src="ag-23-2433-img2.gif" alt="\$u'\$" align="bottom" border="0" height="15" width="17"{$>$} refers to the fluctuating eastward wind, {$<$}img src="ag-23-2433-img3.gif" alt="\$v'\$" align="bottom" border="0" height="15" width="16"{$>$} refers to the fluctuating northward wind, and {$<$}img src="ag-23-2433-img4.gif" alt="\$w'\$" align="bottom" border="0" height="15" width="19"{$>$} refers to the fluctuating vertical wind. Data from radars in New Mexico and Resolute Bay are used to illustrate the data quality, and demonstrate theoretically expected seasonal forcing. {$<$}br{$><$}br{$>$}\textbf{Keywords.} Meteorology and atmospheric dynamics (Middle atmosphere dynamics; Waves and tides; Climatology){$<$}/p{$>$}},
  langid = {english},
  file = {C\:\\Users\\janem\\Zotero\\storage\\ZXURHYV4\\Hocking_2005_A new approach to momentum flux determinations using SKiYMET meteor radars.pdf;C\:\\Users\\janem\\Zotero\\storage\\QXQFWDIT\\2005.html}
}

@article{hocking_RealtimeDeterminationMeteorrelated_2001,
