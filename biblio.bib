@phdthesis{marino_DevelopmentMultistaticMeteor_2024,
  title = {On the {{Development}} of a {{Multistatic Meteor Radar Network}} for {{Investigating Dynamics}} of the {{Upper Atmosphere}}, {{Meteor Science}}, and {{Space Weather}}},
  author = {Marino, John},
  year = 2024,
  address = {United States -- Colorado},
  url = {https://www.proquest.com/docview/3056995616/abstract/9EDEADF2A07C49AFPQ/1},
  urldate = {2024-09-01},
  abstract = {Meteor radars, with a rich history spanning nearly a century, play an important role in the study of meteoroids and the upper atmosphere by observing reflected radio frequency energy scattered from plasma trails formed during ablation. This work, seeking to advance the development of meteor radar instrumentation in pursuit of enriching scientific study of the upper atmosphere, focuses on three primary initiatives: installation and first results from a monostatic meteor radar at McMurdo Station Antarctica, development of a multistatic meteor radar network over Colorado's Front Range, and development of the concept and implementation of a Fully Polarimetric Meteor Radar. The first initiative summarizes observations from a 36.17 MHz all-sky meteor radar installed at McMurdo Station Antarctica (77.8 S, 166.7 E) in Feb 2018 to provide wind measurements in the mesosphere and lower thermosphere (MLT) region (70 - 120 km), including meteor statistics, shower observations, mean zonal and meridional wind components, and an analysis of planetary wave activity and tidal harmonics. Additionally, a method for tracking phase progression of zonally propagating planetary waves across a single-station meteor radar's field of view is presented, along with a discussion of austral summertime semidiurnal oscillation in wind activity. The second initiative describes the development of a multistatic coded continuous wave radar network with transmit-side interferometry, including the system architecture, hardware design, and software and signal processing chain. A detailed description of the calibration procedure utilizing aircraft as calibration targets is presented, along with a summary of first results including meteor statistics and mean zonal and meridional wind components. Finally, the third initiative introduces the concept and implementation of a fully polarimetric meteor radar, in which a complete scattering matrix is constructed at each time step of observation, enabled by the coded continuous wave transmission scheme and transmit-side interferometry utilized in the previously mentioned multistatic meteor radar network. An analysis of the dataset is presented through the lens of polarimetric decomposition, along with a study on extracting aircraft heading and meteor trail orientation.},
  copyright = {Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
  isbn = {979-8-3827-1804-0},
  langid = {english},
  school = {University of Colorado at Boulder},
  keywords = {Aerospace engineering,Astronomy,Atmospheric sciences,Mesosphere and lower thermosphere,Meteor radars,Polarimetric meteor radar,Radio frequency,read,scattering eqn,Space weather},
  file = {C\:\\Users\\janem\\Zotero\\storage\\RPQZKB63\\Marino - 2024 - .pdf;C\:\\Users\\janem\\Zotero\\storage\\TZY4A2F4\\Marino - 2024 - .pdf;C\:\\Users\\janem\\Zotero\\storage\\X89939J7\\Marino - 2024 - On the Development of a Multistatic Meteor Radar N.pdf;C\:\\Users\\janem\\Zotero\\storage\\YH7RDVV4\\Marino - 2024 - .pdf}
}

