@article{betz_ExtendedTheoryEarlyLate_2000,
  title = {Extended {{Theory}} of {{Early-Late Code Tracking}} for a {{Bandlimited GPS Receiver}}},
  author = {Betz, John W. and Kolodziejski, Kevin R.},
  year = 2000,
  journal = {NAVIGATION},
  volume = {47},
  number = {3},
