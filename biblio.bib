}

@article{sugar_FormationPlasmaSmall_2018,
  title = {Formation of {{Plasma Around}} a {{Small Meteoroid}}: {{Simulation}} and {{Theory}}},
  shorttitle = {Formation of {{Plasma Around}} a {{Small Meteoroid}}},
  author = {Sugar, G. and Oppenheim, M. M. and Dimant, Y. S. and Close, S.},
  year = 2018,
  journal = {Journal of Geophysical Research: Space Physics},
  volume = {123},
