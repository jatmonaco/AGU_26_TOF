  langid = {english},
  keywords = {Antarctica,mesosphere,tides},
  file = {C\:\\Users\\janem\\Zotero\\storage\\3QN8LFRF\\Murphy et al. - 2006 - A climatology of tides in the Antarctic mesosphere.pdf;C\:\\Users\\janem\\Zotero\\storage\\BXB78NR9\\Murphy et al. - 2006 - A climatology of tides in the Antarctic mesosphere.pdf;C\:\\Users\\janem\\Zotero\\storage\\DT52G3NS\\Murphy et al. - 2006 - A climatology of tides in the Antarctic mesosphere.pdf;C\:\\Users\\janem\\Zotero\\storage\\FGTAMFWP\\2005JD006803.html;C\:\\Users\\janem\\Zotero\\storage\\LCE5R5SR\\2005JD006803.html}
