@article{kishorekumar_LowlatitudeMesosphericMean_2008,
  title = {Low-Latitude Mesospheric Mean Winds Observed by {{Gadanki}} Mesosphere-Stratosphere-Troposphere ({{MST}}) Radar and Comparison with Rocket, {{High Resolution Doppler Imager}} ({{HRDI}}), and {{MF}} Radar Measurements and {{HWM93}}},
