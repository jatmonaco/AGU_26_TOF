}

@article{stober_MultistaticMultifrequencyNovel_2015,
  ids = {stoberMultistaticMultifrequencyNovel2015b},
  title = {A Multistatic and Multifrequency Novel Approach for Specular Meteor Radars to Improve Wind Measurements in the {{MLT}} Region},
  author = {Stober, G. and Chau, J. L.},
  year = 2015,
  journal = {Radio Science},
